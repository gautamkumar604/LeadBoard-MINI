# Application Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/leaddesk?retryWrites=true&w=majority

# Security & JWT Configuration
JWT_SECRET=generate-a-strong-random-256-bit-secret-key-here
JWT_EXPIRATION=1d

# Security, CORS & Rate Limiting
FRONTEND_URL=https://leaddesk-frontend.vercel.app
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
